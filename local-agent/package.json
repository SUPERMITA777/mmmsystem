{
  "name": "mmm-whatsapp-agent",
  "version": "1.0.0",
  "description": "MMM System - Agente WhatsApp IA (ejecutable standalone)",
  "main": "dist/index.js",
  "bin": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "ts-node src/index.ts",
    "dev": "ts-node src/index.ts",
    "build:exe": "tsc && pkg dist/index.js --targets node18-win-x64 --output MMM-WhatsApp-Agent.exe --compress GZip",
    "build:exe:all": "tsc && pkg dist/index.js --targets node18-win-x64,node18-macos-x64,node18-linux-x64 --out-path ./release --compress GZip"
  },
  "pkg": {
    "assets": [],
    "outputPath": "./release"
  },
  "keywords": ["whatsapp", "bot", "mmm-system", "ai-agent"],
  "author": "MMM System",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@whiskeysockets/baileys": "^7.0.0-rc.9",
    "@hapi/boom": "^10.0.1",
    "axios": "^1.14.0",
    "dotenv": "^17.4.1",
    "pino": "^10.3.1",
    "qrcode-terminal": "^0.12.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/qrcode-terminal": "^0.12.2",
    "pkg": "^5.8.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.0"
  }
}
