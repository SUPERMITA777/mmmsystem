{
    "manifest_version": 3,
    "name": "MMM System - PedidosYa Linker",
    "version": "2.9",
    "description": "Sincronización total de pedidos, catálogo y actualización de precios/stock bidireccional con PedidosYa.",
    "permissions": [
        "storage"
    ],
    "host_permissions": [
        "https://*.supabase.co/*",
        "https://*.pedidosya.com/*",
        "https://*.restaurant-partners.com/*",
        "https://*.vercel.app/*",
        "http://localhost:*/*"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "content_scripts": [
        {
            "matches": [
                "https://partner.pedidosya.com/*",
                "https://go.pedidosya.com/*",
                "https://restaurant.pedidosya.com/*",
                "https://*.pedidosya.com/*",
                "https://*.pedidosya.com.ar/*",
                "https://*.pedidosya.cl/*",
                "https://*.pedidosya.com.uy/*",
                "https://portal-app.pedidosya.com/*"
            ],
            "js": [
                "content.js"
            ],
            "run_at": "document_start"
        }
    ],
    "web_accessible_resources": [
        {
            "resources": [
                "injected.js"
            ],
            "matches": [
                "https://portal-app.pedidosya.com/*",
                "https://*.pedidosya.com/*",
                "https://*.pedidosya.com.ar/*"
            ]
        }
    ],
    "action": {
        "default_popup": "popup.html",
        "default_title": "MMM System PedidosYa"
    }
}
